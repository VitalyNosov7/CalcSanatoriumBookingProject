<Window x:Class="WPFCSB.Views.Windows.BookingOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCSB.Views.Windows"
        mc:Ignorable="d"
        Title="BookingOperationWindow" Height="500" Width="1000">
	<DockPanel LastChildFill="True" Margin="5">

		<!--<Grid Name="GridTop" DockPanel.Dock="Top" Background="Coral" Width="Auto" Height="30">
	<StackPanel Orientation="Horizontal">
		<TextBlock Margin="3,3,3,3" >Поиск</TextBlock>

		<TextBox Margin="3,3,3,3" 
		HorizontalAlignment="Left" 
		Width="200" 
		Height="20" ></TextBox>

		<Button Margin="3,3,3,3">Найти</Button>
	</StackPanel>
</Grid>-->

		<Grid Name="GridBottom" DockPanel.Dock="Bottom" Background="BlanchedAlmond" Width="Auto" Height="30">
			<StackPanel Orientation="Horizontal">
				<Button Margin="3,3,3,3" Command="{Binding AddBookingOperationFromDBCommand}">Добавить</Button>
				<Button Margin="3,3,3,3" Command ="{Binding EditBookingOperationToDBCommand}">Редактировать</Button>
				<Button Margin="3,3,3,3" Command="{Binding DeleteBookingOperationToDBCommand}">Удалить</Button>
				<Button Margin="3,3,3,3" Command="{Binding DeselectBookingOperationCommand}">Снять выделение</Button>
				<Button Margin="3,3,3,3" Command="{Binding UpdateDataЬBookingOperationFromDBCommand}">Обновить данные</Button>
				<Button Margin="3,3,3,3" Command="{Binding OpenWindowsCommands.OpenTextTemplateVariableWindowCommand}">Текстовые переменные</Button>
			</StackPanel>
		</Grid>

		<StackPanel Orientation="Horizontal">

			<Grid Width="200">
				<StackPanel Orientation="Vertical">

					<TextBlock>BookingOperationID</TextBlock>
					<TextBox Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="50" 
					Height="20" 
					Text="{Binding BookingOperationID}"
					IsEnabled="False">
					</TextBox>

					<TextBlock>TextTemplateID</TextBlock>
					<TextBox Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="50" 
					Height="20" 
					Text="{Binding TextTemplateID}"
					IsEnabled="False">
					</TextBox>

					<TextBlock>BookingOperationName</TextBlock>
					<TextBox Name="PersonSurname"
					Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="190" 
					Height="20" 
					Text="{Binding BookingOperationName}">
					</TextBox>

					<TextBlock>TemplateMessageText</TextBlock>
					<TextBox Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="190" 
					Height="200" 
					Text="{Binding TemplateMessageText}"
					AcceptsReturn="True"
					TextWrapping="Wrap"
					VerticalScrollBarVisibility="Auto"
					MinLines="3"
					MaxLines="10">
					</TextBox>

					<TextBlock>PrefixFileName</TextBlock>
					<TextBox Margin="3,3,3,3" 
						HorizontalAlignment="Left" 
						Width="190" 
						Height="20" 
						Text="{Binding PrefixFileName}">
					</TextBox>
				</StackPanel>
			</Grid>

			<Grid>
				<StackPanel Width="Auto"
					Orientation="Vertical">

					<DataGrid ItemsSource="{Binding BookingOperations}" 
							  SelectedItem="{Binding SelectedBookingOperation, Mode=TwoWay}"
							  AutoGenerateColumns="False"
							  GridLinesVisibility="All"
							  CanUserAddRows="False"
							  IsReadOnly="True"
							  Height="400">
						<DataGrid.Columns>
							<DataGridTextColumn Header="BOID" Binding="{Binding BookingOperationID}" Width="50"/>
							<DataGridTextColumn Header="BOName" Binding="{Binding BookingOperationName}" Width="150"/>
							<DataGridTextColumn Header="Префикс" Binding="{Binding PrefixFileName}" Width="150"/>
							<DataGridTextColumn Header="TemplateID" Binding="{Binding TextTemplateID}" Width="50"/>
							<DataGridTextColumn Header="Шаблон" Binding="{Binding TemplateMessageBookingOperation.TemplateMessageText}" Width="200"/>
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</Grid>
		</StackPanel>
	</DockPanel>
</Window>
