<Window x:Class="WPFCSB.Views.Windows.SanatoriumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCSB.Views.Windows"
        mc:Ignorable="d"
        Title="SanatoriumWindow" Height="450" Width="600">
	<DockPanel LastChildFill="True" Margin="5">

		<!--<Grid Name="GridTop" DockPanel.Dock="Top" Background="Coral" Width="Auto" Height="30">
	<StackPanel Orientation="Horizontal">
		<TextBlock Margin="3,3,3,3" >Поиск</TextBlock>

		<TextBox Margin="3,3,3,3" 
		HorizontalAlignment="Left" 
		Width="200" 
		Height="20" ></TextBox>

		<Button Margin="3,3,3,3">Найти</Button>
	</StackPanel>
</Grid>-->

		<Grid Name="GridBottom" DockPanel.Dock="Bottom" Background="BlanchedAlmond" Width="Auto" Height="30">
			<StackPanel Orientation="Horizontal">
				<Button Margin="3,3,3,3" Command="{Binding AddSanatoriumToDBCommand}">Добавить</Button>
				<Button Margin="3,3,3,3" Command ="{Binding EditSanatoriumToDBCommand}">Редактировать</Button>
				<Button Margin="3,3,3,3" Command="{Binding DeleteSanatoriumToDBCommand}">Удалить</Button>
				<Button Margin="3,3,3,3" Command="{Binding DeselectSanatoriumCommand}">Снять выделение</Button>
				<Button Margin="3,3,3,3" Command="{Binding UpdateDataSanatoriumFromDBCommand}">Обновить данные</Button>
			</StackPanel>
		</Grid>

		<StackPanel Orientation="Horizontal">

			<Grid Width="200">
				<StackPanel Orientation="Vertical">

					<TextBlock>SanatoriumID</TextBlock>
					<TextBox Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="100" 
					Height="20" 
					Text="{Binding SanatoriumID}"
					IsEnabled="False">
					</TextBox>

					<TextBlock>SanatoriumName</TextBlock>
					<TextBox Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="100" 
					Height="20" 
					Text="{Binding SanatoriumName}"	>
					</TextBox>

					<TextBlock>EmailSanatorium</TextBlock>
					<TextBox Name="PersonSurname"
					Margin="3,3,3,3" 
					HorizontalAlignment="Left" 
					Width="200" 
					Height="20" 
					Text="{Binding EmailSanatorium}">
					</TextBox>

				</StackPanel>
			</Grid>

			<Grid>
				<StackPanel Width="Auto"
					Orientation="Vertical">

					<ListView  Name="sanatoriumsList" 
						Height="350"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						ItemsSource="{Binding Sanatoriums}"
						SelectedItem="{Binding SelectedSanatorium, Mode=TwoWay}">
						<ListView.View >
							<GridView >
								<GridViewColumn DisplayMemberBinding="{Binding SanatoriumID}" Width="80">SanatoriumID</GridViewColumn>
								<GridViewColumn DisplayMemberBinding="{Binding SanatoriumName}" Width="100">SanatoriumName</GridViewColumn>
								<GridViewColumn DisplayMemberBinding="{Binding EmailSanatorium}" Width="200">EmailSanatorium</GridViewColumn>
							</GridView>
						</ListView.View>
					</ListView>
				</StackPanel>
			</Grid>


		</StackPanel>

	</DockPanel>
</Window>
