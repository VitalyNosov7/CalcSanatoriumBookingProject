<Window x:Class="WPFCSB.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        
        xmlns:ts="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"

        xmlns:local="clr-namespace:WPFCSB"
        xmlns:vm="clr-namespace:WPFCSB.ViewModels"
        mc:Ignorable="d"
        Title="Окно" Height="800" Width="1310">

	<DockPanel LastChildFill="True" Margin="5">
		<!-- Меню панель главного окна-->
		<Menu Name="GridTop1" DockPanel.Dock="Top" Background="Tan" Width="Auto" Height="30">
			<MenuItem Header="Файл">
				<MenuItem Header="Выход" />
			</MenuItem>
			<MenuItem Header="Правка"/>
			<MenuItem Header="База данных" >
				<MenuItem Header="Персоны" Command="{Binding OpenWindowsCommands.OpenPersonWindomCommand}"></MenuItem>
				<MenuItem Header="Менеджеры" Command="{Binding OpenWindowsCommands.OpenManagerWindomCommand}"></MenuItem>
				<MenuItem Header="Санатории" Command="{Binding OpenWindowsCommands.OpenSanatoriumWindomCommand}"></MenuItem>
				<MenuItem Header="Операции бронирования" Command="{Binding OpenWindowsCommands.OpenBookingOperationWindowCommand}"></MenuItem>
				<MenuItem Header="Переменные в тексте" Command="{Binding OpenWindowsCommands.OpenTextTemplateVariableWindowCommand}"></MenuItem>
				<MenuItem Header="Категории номера" Command="{Binding OpenWindowsCommands.OpenRoomCategoryWindowCommand}"></MenuItem>
			</MenuItem>
		</Menu>
		<!--КОНЕЦ Меню панель главного окна-->

		<!-- ТОП панель главного окна-->
		<!--<Grid Name="GridTop2" DockPanel.Dock="Top" Background="AliceBlue" Width="Auto" Height="50">
			<StackPanel Orientation="Horizontal">
				<Button Content="Тестовая кнопка"></Button>
			</StackPanel>
		</Grid>-->
		<!--КОНЕЦ ТОП панель главного окна-->

		<!-- BOTTOM панель главного окна-->
		<Grid Name="GridBottom" DockPanel.Dock="Bottom" Background="BlanchedAlmond" Width="Auto" Height="30"/>
		<!-- КОНЕЦ BOTTOM панель главного окна-->

		<!-- LEFT панель главного окна-->
		<Grid Name="GridLeft" DockPanel.Dock="Left" Background="Aquamarine" Width="100" Height="Auto">

			<StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
				<Button Content="Add Tab" Command="{Binding AddTabCommand}" Margin="0,0,10,0"/>
				<Button Content="Remove Selected Tab"
                    Command="{Binding RemoveTabCommand}"
                    CommandParameter="{Binding SelectedTab}"/>
			</StackPanel>
		</Grid>
		<Grid x:Name="TabArea" Background="LightGreen">
		<!-- КОНЕЦ LEFT панель главного окна-->

			<!-- ОБЛАСТЬ ВКЛАДОК -->
			<TabControl x:Name="myTabControl" ItemsSource="{Binding TabItems}"
            SelectedItem="{Binding SelectedTab}" >

				<!-- Заголовок вкладки -->
				<TabControl.ItemTemplate>
					<DataTemplate>
						<StackPanel  Orientation="Horizontal" x:Name="HeaderPanel" >
							<TextBlock Text="{Binding Header}"/>
							<Button Content="X"
                                Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="5,0,0,0"
                                Padding="3,0"/>
						</StackPanel>
					</DataTemplate>
				</TabControl.ItemTemplate>
				<!--КОНЕЦ заголовок вкладки -->

				<!-- Содержимое вкладки -->
				<TabControl.ContentTemplate>
					<DataTemplate>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="50" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!--Данные бронирования-->
							<StackPanel Name="StackPanelLeft_1"  
                                        Background="Pink" 
                                        Grid.Row="0" 
                                        Grid.Column="0" 
                                        Orientation="Vertical">
								<TextBlock Text="{Binding Content}"/><!--TODO: Подумать как через эту привязку пожно подгружать основное содержимое TabItem-->

								<GroupBox Header="Данные бронирования" 
                                          x:Name="BookingData"
                                          Margin="3">
									<StackPanel>

										<!--ФИО ГОСТЯ-->
										<TextBlock Margin="3,0,0,0" 
                                                Width="100" 
                                                Height="20" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Bottom" 
                                                Text="ФИО гостя"/>
										<TextBox Text="{Binding FullNameMainGuest, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="3,0,3,1"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                VerticalScrollBarVisibility="Auto"/>

										<!--ФИО МЕНЕДЖЕРА-->
										<TextBlock Margin="3,0,0,0" 
                                                 Width="100" 
                                                 Height="20" 
                                                 HorizontalAlignment="Left" 
                                                 VerticalAlignment="Bottom" 
                                                 Text="ФИО менеджера"/>
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="ManagerFIO"
														Width="300"
														Margin="3,0,3,1"
														ItemsSource="{Binding ManagerList}"
														SelectedItem="{Binding SelectedManager,UpdateSourceTrigger=PropertyChanged}"                                                 
														DisplayMemberPath="Name"
														IsTextSearchEnabled="True"                                            
														TextSearch.TextPath="ManagerPerson.FullNamePerson">

												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock>
															<TextBlock.Text>
																<MultiBinding StringFormat="{}{0}">
																	<Binding Path="ManagerPerson.FullNamePerson"/>
																</MultiBinding>

															</TextBlock.Text>
														</TextBlock>
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<Button Content="DB"
													Command="{Binding OpenWindowsCommands.OpenManagerWindomCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>

											<Button Content="R"
													Command="{Binding LoadingManagerListFromDatabaseCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
										</StackPanel>

										<!--НАЗВАНИЕ САНАТОРИЯ-->
										<TextBlock Margin="3,0,0,0" 
                                                   Width="100" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Санаторий"/>
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="Sanatorium"
													  Width="300"
													  Margin="3,0,3,1"
													  ItemsSource="{Binding SanatoriumList}"
													  SelectedItem="{Binding SelectedSanatorium, UpdateSourceTrigger=PropertyChanged}"
													  DisplayMemberPath="Name"
													  IsTextSearchEnabled="True"                                            
													  TextSearch.TextPath="SanatoriumName">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock>
															<TextBlock.Text>
																<MultiBinding StringFormat="{}{0}">
																	<Binding Path="SanatoriumName"/>
																</MultiBinding>
															</TextBlock.Text>
														</TextBlock>
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<Button Content="DB"
													Command="{Binding OpenWindowsCommands.OpenSanatoriumWindomCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>

											<Button Content="R"
													Command="{Binding LoadingSanatoriumListFromDatabaseCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>	
										</StackPanel>

										<StackPanel Orientation="Horizontal">
											<!--ДАТА ЗАЕЗДА-->
											<StackPanel Orientation="Vertical">
												<TextBlock Margin="3,0,0,0" 
                                                               Width="100" 
                                                               Height="20" 
                                                               HorizontalAlignment="Left" 
                                                               VerticalAlignment="Bottom" 
                                                               Text="Дата заезда"/>
												<DatePicker Name="StartDateBooking"
															Width="100"
                                                            HorizontalAlignment="Left" 
                                                            SelectedDate="{Binding StartDatePeriodBooking,
                                                                            UpdateSourceTrigger=PropertyChanged}"/>

											</StackPanel>
											<!--ДАТА ВЫЕЗДА-->
											<StackPanel Orientation="Vertical">
												<TextBlock Margin="3,0,0,0" 
                                                                Width="100" 
                                                                Height="20" 
                                                                HorizontalAlignment="Left" 
                                                                VerticalAlignment="Bottom" 
                                                                Text="Дата выезда"/>
												<DatePicker Width="100"
															HorizontalAlignment="Left" 
                                                            SelectedDate="{Binding EndDatePeriodBooking, 
                                                                            UpdateSourceTrigger=PropertyChanged}"/>

											</StackPanel>

											<!--КОЛИЧЕСТВО НОЧЕЙ-->
											<StackPanel Orientation="Vertical">
												<TextBlock Margin="0,0,0,0" 
                                                           Width="70" 
                                                           Height="20" 
                                                           HorizontalAlignment="Left" 
                                                           VerticalAlignment="Bottom" 
                                                           Text="К-во ночей"/>
												<TextBox   Text="{Binding NumberNightsBooked, 
																UpdateSourceTrigger=PropertyChanged}" 														   
                                                           Margin="0,0,0,0"
                                                           Width="60"
                                                           HorizontalAlignment="Left"
                                                           IsEnabled="False"/>
											</StackPanel>

											<!--КОЛИЧЕСТВО ДНЕЙ ДО ЗАЕЗДА-->
											<StackPanel Orientation="Vertical">
												<TextBlock Margin="0,0,0,0" 
                                                           Width="100" 
                                                           Height="20" 
                                                           HorizontalAlignment="Left" 
                                                           VerticalAlignment="Bottom" 
                                                           Text="Дней до заезда:"/>
												<TextBox   Text="{Binding NumberDaysUntilBooking, 
														UpdateSourceTrigger=PropertyChanged}" 														   
                                                           Margin="0,0,0,0"
                                                           Width="60"
                                                           HorizontalAlignment="Left"
                                                           IsEnabled="False"/>
											</StackPanel>

										</StackPanel>
										<!--КАТЕГОРИЯ САНАТОРИЯ-->
										<TextBlock Margin="3,0,0,0" 
                                                   Width="150" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Категория санатория"/>
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="RoomCategory"
												  Width="300"
												  Margin="3,0,3,1"
												  ItemsSource="{Binding RoomCategoryList}"
												  SelectedItem="{Binding SelectedRoomCategory, UpdateSourceTrigger=PropertyChanged}"
												  DisplayMemberPath="Name"
												  IsTextSearchEnabled="True"                                            
												  TextSearch.TextPath="RoomCategoryName">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock>
														<TextBlock.Text>
															<MultiBinding StringFormat="{}{0}">
																<Binding Path="RoomCategoryName"/>
															</MultiBinding>
														</TextBlock.Text>
													</TextBlock>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
											<Button Content="DB"
													Command="{Binding OpenWindowsCommands.OpenRoomCategoryWindowCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
											<Button Content="R"
													Command="{Binding LoadingRoomCategoryListFromDatabaseCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>		
										</StackPanel>

										<!--ВИД РАЗМЕЩЕНИЯ-->
										<TextBlock Margin="3,0,0,0" 
                                                   Width="150" 
                                                   Height="20"
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Вид размещения"/>
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="AccommodationType"
												  Width="300"
												  Margin="3,0,3,1"
												  ItemsSource="{Binding AccommodationTypeList}"
												  SelectedItem="{Binding SelectedAccommodationType, UpdateSourceTrigger=PropertyChanged}"
												  DisplayMemberPath="Name"
												  IsTextSearchEnabled="True"                                            
												  TextSearch.TextPath="AccommodationTypeName">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock>
														<TextBlock.Text>
															<MultiBinding StringFormat="{}{0}">
																	<Binding Path="AccommodationTypeName"/>
															</MultiBinding>
														</TextBlock.Text>
													</TextBlock>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
											<Button Content="DB"
												Command="{Binding OpenWindowsCommands.OpenAccommodationTypeWindowCommand}"
												Width="30"
												Height="20"
												Margin="3,3,3,3"/>

											<Button Content="R"
													Command="{Binding LoadingAccommodationTypeListFromDatabaseCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
										</StackPanel>

										<!--ГОСТЬ-->
										<TextBlock Margin="3,0,0,0" 
												   Width="150" 
												   Height="20"
												   HorizontalAlignment="Left" 
												   VerticalAlignment="Bottom" 
												   Text="Гость"/>
										<StackPanel Orientation="Horizontal">

											<TextBox Width="300"
												Margin="3,0,3,1"></TextBox>
											<Button Content="DB"
												Command="{Binding }"
												Width="30"
												Height="20"
												Margin="3,3,3,3"/>
										</StackPanel>
										<!--ТАРИФ-->
										<TextBlock Margin="3,0,0,0" 
												   Width="150" 
												   Height="20"
												   HorizontalAlignment="Left" 
												   VerticalAlignment="Bottom" 
												   Text="Тариф"/>		
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="TarifCategory"
													  Width="300"
													  Margin="3,0,3,1"
													  ItemsSource="{Binding TarifCategoryList}"
													  SelectedItem="{Binding SelectedTarifCategory, UpdateSourceTrigger=PropertyChanged}"
													  DisplayMemberPath="Name"
													  IsTextSearchEnabled="True"                                            
													  TextSearch.TextPath="TarifCategoryName">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock>
															<TextBlock.Text>
																<MultiBinding StringFormat="{}{0}">
																	<Binding Path="TarifCategoryName"/>
																</MultiBinding>
															</TextBlock.Text>
														</TextBlock>
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<Button Content="DB"
													Command="{Binding }"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
											<Button Content="R"
													Command="{Binding }"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
										</StackPanel>										

										<StackPanel Orientation="Horizontal">
											<Button Content="Добавить" Margin="3,3,3,3" Width="100"></Button>
											<Button Content="Удалить" Margin="3,3,3,3"  Width="100"></Button>
										</StackPanel>

										<!--СПИСОК ГОСТЕЙ-->
										<TextBlock Margin="3,0,0,0" 
												   Width="150" 
												   Height="20"
												   HorizontalAlignment="Left" 
												   VerticalAlignment="Bottom" 
												   Text="Гости"/>

										<TextBox Width="350" 
												Height="100"
												HorizontalAlignment="Left">
											
										</TextBox>

									</StackPanel>
								</GroupBox>						
							</StackPanel>
							<!--КОНЕЦ Данные бронирования-->

							<!--Формирование шаблона-->
							<StackPanel Name="StackPanelLeft_2"  
                                        Background="Brown" 
                                        Grid.Row="0" 
                                        Grid.Column="1" 
                                        Orientation="Vertical">
								<GroupBox Header="Формирование шаблона" 
                                          x:Name="CalcData"
                                          Margin="3">

									<!--ОПЕРАЦИИ БРОНИРОВАНИЯ-->
									<StackPanel Orientation="Vertical">
										<TextBlock Margin="3,0,0,0" 
                                                 Width="100" 
                                                 Height="20" 
                                                 HorizontalAlignment="Left" 
                                                 VerticalAlignment="Bottom" 
                                                 Text="Операция"/>
										<StackPanel Orientation="Horizontal">
											<ComboBox x:Name="MessageTemplate"
												  Width="300"
                                                  Margin="3,0,3,1"
                                                  ItemsSource="{Binding BookingOperationList}"
                                                  SelectedItem="{Binding SelectedBookingOperation, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  IsTextSearchEnabled="True"                                            
                                                  TextSearch.TextPath="BookingOperationName">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock>
															<TextBlock.Text>
																<MultiBinding StringFormat="{}{0}">
																	<Binding Path="BookingOperationName"/>
																</MultiBinding>
															</TextBlock.Text>
														</TextBlock>
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<Button Content="DB"
													Command="{Binding OpenWindowsCommands.OpenBookingOperationWindowCommand}"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
											<Button Content="R"
													Command="{Binding }"
													Width="30"
													Height="20"
													Margin="3,3,3,3"/>
										</StackPanel>
										<StackPanel Orientation="Horizontal">
											<Button Content="Сформировать шаблон" Command="{Binding GetTemplameMessageCommand}"  Margin="3,3"></Button>
											<Button Content="Скопировать шаблон" Command="{Binding CopyTemplameMessageCommand}" Margin="3,3"></Button>
										</StackPanel>

										<!--РАСЧЕТ БРОНИ-->
										<TextBlock Margin="0,0,0,0" 
                                                   Width="70" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Расчет брони"/>

										<TextBox Text="{Binding CalcBookingString, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="Auto" 
                                                Height="50"/>

										<!--ОПИСАНИЕ-->
										<TextBlock Margin="0,0,0,0" 
                                                   Width="70" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Описание"/>

										<TextBox Width="Auto" 
                                                 Height="80"
                                                 Text="{Binding DescriptionBooking,UpdateSourceTrigger=PropertyChanged}"/>

										<!--СФОРМИРОВАННЫЙ ШАБЛОН-->
										<TextBlock Margin="0,0,0,0" 
                                                   Width="70" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Описание"/>

										<TextBox Text="{Binding ResultTemplate}" 
                                                    Width="Auto" 
                                                    Height="200"/>
									</StackPanel>
								</GroupBox>
							</StackPanel>
							<!--КОНЕЦ Формирование шаблона-->

							<!--Дополнительная панель-->
							<StackPanel Name="StackPanelLeft_3" 
                                        Background="Yellow" 
                                        Grid.Row="0"
                                        Grid.Column="2" 
                                        Orientation="Vertical">
								<GroupBox Header="Дополнительная панель" 
										  x:Name="RitePanelTab"
										  Margin="3">
									<StackPanel Orientation="Vertical">
										<!--Имя файла-->
										<TextBlock Margin="3,0,0,0" 
                                           Width="70" 
                                           Height="20" 
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Bottom" 
                                           Text="Имя файла"/>

										<TextBox Text="{Binding FileName}" Width="Auto" />

										<StackPanel Orientation="Horizontal">
											<Button Content="Создать имя файла" Command="{Binding CreateFileNameCommand}" Margin="3,3"></Button>
											<Button Content="Скопировать имя файла" Command="{Binding CopyFileNameCommand}" Margin="3,3"></Button>
										</StackPanel>
										<!--КОНЕЦ Имя файла-->
									</StackPanel>
								</GroupBox>
							</StackPanel>
							<!--Дополнительная панель-->

							<!--Bottom панель вкладки-->
							<StackPanel Name="TabStackPanelBottom"  
										Background="ForestGreen" 
										Grid.Row="1" 
										Grid.ColumnSpan="3"
										Orientation="Horizontal">

								<Button Content="Обновить списки"
								Command="{Binding LoadingListsFromDatabaseCommand}"/>
							</StackPanel>
							<!--Bottom панель вкладки-->
						</Grid>
					</DataTemplate>
				</TabControl.ContentTemplate>
				<!-- КОНЕЦ содержимое вкладки -->
			</TabControl>
			<!--КОНЕЦ ОБЛАСТЬ ВКЛАДОК -->

		</Grid>
	</DockPanel>
</Window>
