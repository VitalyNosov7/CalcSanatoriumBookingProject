<Window x:Class="WPFCSB.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCSB"
        xmlns:vm="clr-namespace:WPFCSB.ViewModels"
        mc:Ignorable="d"
        Title="Окно" Height="450" Width="800">

    <DockPanel LastChildFill="True" Margin="5">
        <Menu Name="GridTop1" DockPanel.Dock="Top" Background="Tan" Width="Auto" Height="30">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" />
            </MenuItem>
            <MenuItem Header="Правка"/>
        </Menu>
        <Grid Name="GridTop2" DockPanel.Dock="Top" Background="AliceBlue" Width="Auto" Height="50"/>
        <Grid Name="GridBottom" DockPanel.Dock="Bottom" Background="BlanchedAlmond" Width="Auto" Height="30"/>
        <Grid Name="GridLeft" DockPanel.Dock="Left" Background="Aquamarine" Width="100" Height="Auto">
   
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                <Button Content="Add Tab" Command="{Binding AddTabCommand}" Margin="0,0,10,0"/>
                <Button Content="Remove Selected Tab"
                    Command="{Binding RemoveTabCommand}"
                    CommandParameter="{Binding SelectedTab}"/>                
            </StackPanel>
        </Grid>
        <Grid x:Name="TabArea" Background="LightGreen">
            <TabControl x:Name="myTabControl" ItemsSource="{Binding TabItems}"
            SelectedItem="{Binding SelectedTab}" >
             
                
                <TabControl.ItemTemplate>
                    <!-- Шаблон для заголовка таба -->
                    <DataTemplate>


                        <StackPanel  Orientation="Horizontal" x:Name="HeaderPanel" >

                            <TextBlock Text="{Binding Header}"/>
                            <Button Content="X"
                                Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="5,0,0,0"
                                Padding="3,0"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <!-- Шаблон для содержимого таба -->
                    <DataTemplate>
                      
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Name="StackPanelLeft_1"  
                                        Background="Pink" 
                                        Grid.Row="0" 
                                        Grid.Column="0" 
                                        Orientation="Vertical">
                                <TextBlock Text="{Binding Content}"/>

                                <GroupBox Header="Данные бронирования" 
                                          x:Name="BookingData"
                                          Margin="3">
                                    <StackPanel>
                                        
                                        <!--ФИО ГОСТЯ-->
                                        <TextBlock Margin="3,0,0,0" 
                                                Width="100" 
                                                Height="20" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Bottom" 
                                                Text="ФИО гостя"/>
                                        <TextBox Text="" 
                                                Margin="3,0,3,1"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                VerticalScrollBarVisibility="Auto"/>
                                        
                                        <!--ФИО МЕНЕДЖЕРА-->
                                        <TextBlock Margin="3,0,0,0" 
                                                 Width="100" 
                                                 Height="20" 
                                                 HorizontalAlignment="Left" 
                                                 VerticalAlignment="Bottom" 
                                                 Text="ФИО менеджера"/>
                                        <ComboBox x:Name="ManagerFIO"
                                                  Margin="3,0,3,1"
                                                  ItemsSource="{Binding ManagerFullNameList}"/>



                                        <!--НАЗВАНИЕ САНАТОРИЯ-->
                                        <TextBlock Margin="3,0,0,0" 
                                                   Width="100" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Санаторий"/>
                                        <ComboBox  Margin="3,0,3,1">
                                            <TextBlock>Планета</TextBlock>
                                            <TextBlock>Киев</TextBlock>
                                            <TextBlock>ТЭС</TextBlock>
                                            <TextBlock>Сакрополь</TextBlock>
                                            <TextBlock>Рябинка</TextBlock>
                                            <TextBlock>Озеро сновидений</TextBlock>
                                            <TextBlock>Узбекистан</TextBlock>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal">
                                            
                                            <StackPanel Orientation="Vertical">
                                                
                                                <!--ДАТА ЗАЕЗДА-->
                                                <TextBlock Margin="3,0,0,0" 
                                                               Width="100" 
                                                               Height="20" 
                                                               HorizontalAlignment="Left" 
                                                               VerticalAlignment="Bottom" 
                                                               Text="Дата заезда"/>
                                                <DatePicker Width="100"
                                                                HorizontalAlignment="Left" />
                                            </StackPanel>                                            
                                            <StackPanel Orientation="Vertical">

                                                <!--ДАТА ВЫЕЗДА-->
                                                <TextBlock Margin="3,0,0,0" 
                                                               Width="100" 
                                                               Height="20" 
                                                               HorizontalAlignment="Left" 
                                                               VerticalAlignment="Bottom" 
                                                               Text="Дата выезда"/>
                                                <DatePicker Width="100"
                                                            HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">

                                                <!--КОЛИЧЕСТВО НОЧЕЙ-->
                                                <TextBlock Margin="3,0,0,0" 
                                                           Width="100" 
                                                           Height="20" 
                                                           HorizontalAlignment="Left" 
                                                           VerticalAlignment="Bottom" 
                                                           Text="К-во ночей"/>
                                                <TextBox   Text="" 
                                                           Margin="3,0,3,1"
                                                           Width="60"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                            
                                        </StackPanel>
                                        <!--КАТЕГОРИЯ САНАТОРИЯ-->
                                        <TextBlock Margin="3,0,0,0" 
                                                   Width="150" 
                                                   Height="20" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Категория санатория"/>
                                        <TextBox   Text="" 
                                                   Margin="3,0,3,1"
                                                   TextWrapping="Wrap"
                                                   AcceptsReturn="True"
                                                   VerticalScrollBarVisibility="Auto"/>

                                        <!--ВИД РАЗМЕЩЕНИЯ-->
                                        <TextBlock Margin="3,0,0,0" 
                                                   Width="150" 
                                                   Height="20"
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Bottom" 
                                                   Text="Вид размещения"/>
                                        <TextBox   Margin="3,0,3,1"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Данные санатория" 
                                          x:Name="SanatoriumData"
                                          Margin="3">
                                    <StackPanel>
                                        <TextBlock Margin="3,0,0,0" 
                                                     Width="100" 
                                                     Height="20" 
                                                     HorizontalAlignment="Left" 
                                                     VerticalAlignment="Bottom" 
                                                     Text="Санаторий"/>
                                        <TextBox Text="{Binding Content}" 
                                                     Margin="3,0,3,1"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Name="StackPanelLeft_2"  
                                        Background="Brown" 
                                        Grid.Row="0" 
                                        Grid.Column="1" 
                                        Orientation="Vertical">
                                <GroupBox Header="Данные расчета" 
                                          x:Name="CalcData"
                                          Margin="3">
                                    <StackPanel>
                                        <TextBlock Margin="5" 
                                                Width="100" 
                                                Height="20" 
                                                Text="Какой то текст"/>
                                        <TextBox Text="{Binding Content}"
                                                Margin="5"
                                                TextWrapping="Wrap"
                                                AcceptsReturn="True"
                                                VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Name="StackPanelLeft_3"  Background="Yellow" Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                                <TextBlock Margin="5" Width="100" Height="20" >Какой то текст</TextBlock>
                                <TextBox Text="{Binding Content}" Margin="5"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>                      
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
